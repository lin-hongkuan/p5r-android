# Everything derived from the game, keys and firmware stays local. Never commit.
private/
__pycache__/
*.pyc

# Game dumps must never be committed, wherever they are dropped.
*.xci
*.xci.rar
*.nsp
*.nsz
*.xcz
*.rar
*.keys

# Local tooling state and run logs.
nx.log
*.log

# Scratch output from local compiler probes and proofs (CONTRIBUTING-FORK.md §2: temporary work goes in private/,
# which is ignored above). These patterns only catch build artifacts, never sources.
*.exe
*.o
*.obj
tests/tmp_*.cpp

